              "sfx": "grow"
            },
            {
              "target": "repka",
              "fx": "sparkle",
              "delayMs": 700
            }
          ]
        }
      }
    },
    {
      "id": "p2",
      "text": "Пошёл дед репку рвать. Тянет-потянет, вытянуть не может.",
