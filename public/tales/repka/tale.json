  "pages": [
    {
      "id": "p1",
      "text": "Посадил дед репку. Выросла репка большая-пребольшая.",
      "narration": { "src": "audio/p1.mp3" },
      "translations": {
        "en": {
          "text": "Grandpa planted a turnip. The turnip grew big — very, very big!"
        }
      },
      "scene": {
        "background": "field",
        "elements": [
          {
            "id": "ded",
            "sprite": "ded",
            "x": 560,
            "y": 560,
            "scale": 1.0,
            "onTap": "hello"
          },
          {
            "id": "repka",
            "sprite": "repka",
            "x": 820,
            "y": 560,
            "state": "small",
            "onTap": "grow"
          }
        ],
        "actions": {
          "hello": [
            {
              "target": "ded",
              "animation": "hop",
              "sfx": "boop"
            }
          ],
          "grow": [
